{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    /*
     * DOM is needed even though the server runs in Node: the shared schema modules reference
     * `window.Api` inside codec transform closures, and everything under `src/client/tools/` runs in the
     * SudokuMaker page. Node types are needed for bin/, utils/, and vite.config.ts.
     */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "bin", "utils", "vite.config.ts"]
}
